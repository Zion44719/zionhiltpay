# ============================================================================
# ZionhiltPay backend — environment configuration
# Copy this file to `.env` and fill in real values. NEVER commit the real .env.
# ============================================================================

APP_NAME=ZionhiltPay
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true

# --- Database ---
DATABASE_URL=postgresql+asyncpg://zionhilt:zionhilt@db:5432/zionhiltpay
SYNC_DATABASE_URL=postgresql+psycopg2://zionhilt:zionhilt@db:5432/zionhiltpay

# --- Security / JWT ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_super_secret_key_min_32_chars

# Encrypts customers' ID numbers at rest. REQUIRED when APP_ENV=production. Back it up: if it is lost,
# stored ID numbers cannot be decrypted. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DATA_ENCRYPTION_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PIN_MAX_FAILED_ATTEMPTS=3
PIN_LOCK_MINUTES=30

# --- OTP ---
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Email delivery ---
# console = prints OTP to server logs (default, dev only; withheld when APP_ENV=production)
# smtp    = sends real email via the SMTP creds below
#   Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
#   SMTP_PASSWORD=<16-char Google App Password, NOT your normal password>
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@zionhiltpay.local

# --- SMS delivery ---
# console = prints OTP to server logs (default, dev only; withheld when APP_ENV=production)
# termii  = real SMS via Termii; SMS_API_KEY is your Termii API key
# twilio  = real SMS via Twilio; SMS_API_KEY must be ACCOUNT_SID:AUTH_TOKEN:FROM_NUMBER
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=ZionhiltPay

# --- CORS (comma-separated list handled by pydantic-settings as JSON array too) ---
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Business rules (also editable live via /api/admin/config as super_admin) ---
REWARD_RATE=0.0050
INSURANCE_CONTRIBUTION_RATE=0.0100
TRANSACTION_FEE_RATE=0.0150
WITHDRAWAL_FEE_FLAT=25.00

# --- AI agents (Claude) ---
# Leave ANTHROPIC_API_KEY empty to disable all agent features (endpoints return 503, UI shows a notice).
# Get a key at https://console.anthropic.com. The key stays on the backend; the browser never sees it.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
AGENT_MODEL=claude-sonnet-5-5
AGENT_MAX_TOKENS=1024
AGENT_MAX_TOOL_ROUNDS=5
RATE_LIMIT_AGENT=20/minute

# --- Mock payment gateway ---
MOCK_GATEWAY_SUCCESS_RATE=0.95
MOCK_GATEWAY_LATENCY_MS=400

# --- Lookup rate limit (username availability + recipient name enquiry) ---
RATE_LIMIT_LOOKUP=20/minute

# --- Uploaded files (profile photos, proof-of-address images) ---
# Stored on disk, outside any web-served folder, and only ever returned through authenticated endpoints.
# A relative path is relative to the backend folder. In Docker this is a persistent volume.
UPLOAD_DIR=uploads
MAX_PHOTO_BYTES=3000000
MAX_DOCUMENT_BYTES=6000000
MAX_LOGO_BYTES=1000000              # partner logos shown on the landing page

# --- Account tiers: daily outgoing limit and maximum wallet balance (NGN, 0 = unlimited) ---
# Defaults follow the CBN's 2017 mobile-money KYC circular. Published figures differ between sources and
# change over time: confirm the limits that apply to YOUR licence before launching.
TIER1_DAILY_LIMIT=50000
TIER1_MAX_BALANCE=300000
TIER2_DAILY_LIMIT=200000
TIER2_MAX_BALANCE=500000
TIER3_DAILY_LIMIT=5000000
TIER3_MAX_BALANCE=0

# --- Transfers to other banks: bank list + account-name lookup ---
# mock     = built-in sample bank list and made-up account names (works offline)
# paystack = live bank list and real name lookup via Paystack (needs PAYSTACK_SECRET_KEY)
# Note: the payout itself is still simulated by the mock payment gateway either way.
BANK_PROVIDER=mock
PAYSTACK_SECRET_KEY=

# --- Loans (lending is regulated in Nigeria: get proper registration and advice before offering real loans) ---
LOANS_ENABLED=true
LOAN_MIN_AMOUNT=1000
LOAN_TIER2_MAX=50000
LOAN_TIER3_MAX=500000
LOAN_TENORS_DAYS=[7,14,30]
LOAN_INTEREST_RATE_30D=0.05
